{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Kage Scribe",
  "version": "1.0.0",
  "key": "",
  "description": "Save your chats from isekaizero.ai and kagesekai.ai, and download them as Word, Excel, CSV or JSON.",
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "host_permissions": [
    "https://kagesekai.ai/*",
    "https://*.kagesekai.ai/*",
    "https://isekaizero.ai/*",
    "https://*.isekaizero.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kagesekai.ai/*",
        "https://*.kagesekai.ai/*",
        "https://isekaizero.ai/*",
        "https://*.isekaizero.ai/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kagesekai.ai/*",
        "https://*.kagesekai.ai/*",
        "https://isekaizero.ai/*",
        "https://*.isekaizero.ai/*"
      ],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kage Scribe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
